<Window x:Class="nzikrov.Reg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nzikrov"
        mc:Ignorable="d"
        Title="Регистрация/Авторизация" Height="550" Width="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="21*"/>
            <RowDefinition Height="123*"/>
            <RowDefinition Height="56*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="1" Grid.Row="1" Source="img/images.png" Stretch="Fill" Margin="22,-1,22,56" Grid.RowSpan="2"/>

        <TextBlock Grid.Column="1" Grid.Row="2" Text="Логин" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Height="29" Width="77" Margin="0,17,0,0" FontFamily="Verdana" FontStyle="Italic"/>
        <TextBox x:Name="tbxLogin"  Grid.Column="1" HorizontalAlignment="Center" Height="47" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,13,0,0" Width="180"/>
        <TextBlock Grid.Column="1" Grid.Row="4" Text="Пароль" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Height="29" Width="93" Margin="0,27,0,0" FontFamily="Verdana" FontStyle="Italic"/>
        <TextBox x:Name="tbxPass"  Grid.Column="1" HorizontalAlignment="Center" Height="47" Grid.Row="5" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,13,0,0" Width="180"/>

        <Button Grid.Row="6" Grid.Column="1" Content="Вход" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnOpen_Click" RenderTransformOrigin="0.487,0.969" Foreground="White"  FontFamily="Verdana" FontSize="20" FontStyle="Italic" Height="45" Width="180" >
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="BorderBrush" Value="#79BE1F"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#5F9F0C"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="BlueViolet"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Image Grid.Column="1" Margin="111,78,69,45" Grid.Row="1" Source="/img/images.png" Stretch="Fill"/>
    </Grid>
</Window>
