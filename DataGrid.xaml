<Window x:Class="nzikrov.DataGrid"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nzikrov"
        mc:Ignorable="d"
        Title="DataGrid" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24*"></RowDefinition>
            <RowDefinition Height="7*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="701*"></ColumnDefinition>
            <ColumnDefinition Width="99*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Margin="0,3,0,1">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Button Content="Add" Grid.Column="0" Margin="0,-5,0,110" Click="Button_Click" Grid.RowSpan="2" Foreground="White"  FontFamily="Verdana" FontSize="20" FontStyle="Italic">
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#5F9F0C" Offset="0.783"/>
                        <GradientStop Color="#79BE1F"/>
                        <GradientStop Color="#5F9F0C"/>
                        <GradientStop Color="#5F9F0C" Offset="0.54"/>
                        <GradientStop Color="#5F9F0C"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button Content="Edit" Grid.Row="1" Click="EditButton_Click" Foreground="White"  FontFamily="Verdana" FontSize="20" FontStyle="Italic">
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#5F9F0C" Offset="0.783"/>
                        <GradientStop Color="#79BE1F"/>
                        <GradientStop Color="#5F9F0C"/>
                        <GradientStop Color="#5F9F0C" Offset="0.54"/>
                        <GradientStop Color="#5F9F0C"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button Content="Delete" Margin="0,110,0,0" Grid.Row="1" Grid.RowSpan="2" Click="Button_Click_1" Foreground="White"  FontFamily="Verdana" FontSize="20" FontStyle="Italic">
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#5F9F0C" Offset="0.783"/>
                        <GradientStop Color="#79BE1F"/>
                        <GradientStop Color="#5F9F0C"/>
                        <GradientStop Color="#5F9F0C" Offset="0.54"/>
                        <GradientStop Color="#5F9F0C"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
        <DataGrid x:Name="ProductsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"  Background="#B7FC5C">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProductID}" Width="auto"/>
                <DataGridTextColumn Header="Название" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="Auto"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
