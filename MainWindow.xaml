<Window x:Class="nzikrov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nzikrov"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Главная" Height="600" Width="1000">
    <Grid Background="#B7FC5C">
        <Grid.RowDefinitions>
            <RowDefinition Height="53*"/>
            <RowDefinition Height="122*"></RowDefinition>
            <RowDefinition Height="39*"/>
            <RowDefinition Height="82*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="67*">
            </ColumnDefinition>
            <ColumnDefinition Width="66*"></ColumnDefinition>
            <ColumnDefinition Width="67*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="2" Content="Добавить продукт" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Width="268" Click="Button_Click" Foreground="White"  FontFamily="Verdana" FontSize="25" FontStyle="Italic" Height="100">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#5F9F0C" Offset="0.783"/>
                    <GradientStop Color="#79BE1F"/>
                    <GradientStop Color="#5F9F0C"/>
                    <GradientStop Color="#5F9F0C" Offset="0.54"/>
                    <GradientStop Color="#5F9F0C"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="Авторизация" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Width="272" Click="AutoClick" Foreground="White"  FontFamily="Verdana" FontSize="25" FontStyle="Italic" Height="100">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#5F9F0C" Offset="0.783"/>
                    <GradientStop Color="#79BE1F"/>
                    <GradientStop Color="#5F9F0C"/>
                    <GradientStop Color="#5F9F0C" Offset="0.54"/>
                    <GradientStop Color="#5F9F0C"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <TextBox TextWrapping="Wrap" Text="" Margin="42,0,42,4" Grid.Row="3" Grid.ColumnSpan="3" TextChanged="TextBox_TextChanged"/>
        <TextBox TextWrapping="Wrap" Text="" Margin="46,9,38,3" Grid.Row="5" Grid.ColumnSpan="3" TextChanged="TextBox_TextChanged_1"/>
        <ListBox x:Name="ProductListBox" Margin="46,24,38,24" Grid.Row="6" FontFamily="Verdana" FontSize="16" Background="#FFF1F1F1" Grid.RowSpan="3" Grid.ColumnSpan="3" SelectionChanged="ProductListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" Foreground="Gray" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
