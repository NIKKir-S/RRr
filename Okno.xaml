<Window x:Class="nzikrov.Okno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nzikrov"
        mc:Ignorable="d"
            Title="Okno" Height="735" Width="576">
    <Grid HorizontalAlignment="Center" Width="576" Background="#B7FC5C">
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="94*" ></RowDefinition>
            <RowDefinition Height="16*"/>
            <RowDefinition Height="144*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="161*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="195*"/>
            <RowDefinition Height="0*"/>
            <RowDefinition Height="0*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="79*">
            </ColumnDefinition>
            <ColumnDefinition Width="242*"></ColumnDefinition>
            <ColumnDefinition Width="80*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="nameTextBox" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap"  VerticalAlignment="Center" Width="328" Height="42"/>
        <TextBox x:Name="priceTextBox" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap"  VerticalAlignment="Center" Width="328" Height="42"/>
        <TextBox x:Name="descriptionTextBox" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="5" TextWrapping="Wrap"  VerticalAlignment="Center" Width="328" Height="42"/>
        <Button Grid.Column="1" Content="Добавить" HorizontalAlignment="Center" Grid.Row="7" VerticalAlignment="Center" Height="75" Width="328" Click="SaveButton_Click" Foreground="White"  FontFamily="Verdana" FontSize="30" FontStyle="Italic">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#5F9F0C" Offset="0.783"/>
                    <GradientStop Color="#79BE1F"/>
                    <GradientStop Color="#5F9F0C"/>
                    <GradientStop Color="#5F9F0C" Offset="0.54"/>
                    <GradientStop Color="#5F9F0C"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>
